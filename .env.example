INACTIVITY_DAYS=14
LOW_SCORE_THRESHOLD=40
RISK_HIGH_BELOW=40
RISK_MEDIUM_BELOW=65
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
